#
# Deep suspend is not reliable on this board: the power key sometimes cannot
# wake it and the machine can stay dead until the 15 s reset (see
# KNOWN-ISSUES.md 2.5.6).  Keep the system on s2idle; the kernel command line
# already defaults to it and this rule re-applies it after power events.
SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="USB", ENV{POWER_SUPPLY_ONLINE}=="1", RUN+="/usr/local/libexec/nabu-mem-sleep"
SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="USB", ENV{POWER_SUPPLY_ONLINE}=="0", RUN+="/usr/local/libexec/nabu-mem-sleep"
