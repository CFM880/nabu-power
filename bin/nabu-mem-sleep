#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# nabu-mem-sleep - keep the system on s2idle.
#
# Platform "mem" (deep) suspend is not reliable on this board: the power key
# fails to wake it now and then (the PMIC latches the PON interrupt and
# PON_INT_EN is set - verified with the SDAM black box - but the SPMI summary
# -> PDC path does not always take the SoC out of AOSS), and in the worst case
# the machine stays dead until the 15 s power-button reset.  s2idle keeps the
# CPU available for the key interrupt and has been reliable on both AC and
# battery, so use it by default.  The cost is the standby drain (~1.5 %/h on
# s2idle versus ~0.1 %/h on deep); `echo deep > /sys/power/mem_sleep` still
# switches the current boot to deep for anyone who accepts that risk.
#
# Called from 60-nabu-mem-sleep.rules on the USB power supply's online
# transitions, and the kernel command line already carries
# mem_sleep_default=s2idle.  Details: docs/KNOWN-ISSUES.md 2.5.6.

set -u

mode=s2idle

[ -w /sys/power/mem_sleep ] || exit 0

case " $(cat /sys/power/mem_sleep) " in
*"[$mode]"*)
	exit 0		# already selected
	;;
esac

echo "$mode" > /sys/power/mem_sleep
