# SPDX-License-Identifier: GPL-2.0-only
#
# The dwc3 controllers (and their xHCI companions) come up with
# power/control == "on", i.e. runtime PM disabled, so they never suspend and
# keep drawing power while the tablet sits with the screen off.
#
#   a600000.usb       dwc3, Type-C port
#   a800000.usb       dwc3, keyboard cover
#   xhci-hcd.*.auto   xHCI companion
#
# Measured on the tablet with the screen blanked: switching the USB controllers
# alone still takes the idle draw from ~1.1 W to ~0.6 W, with the Type-C console
# and the keyboard cover still working.
#
# Deliberately NOT included: aa00000.video-codec (iris VPU).  Forcing it to
# "auto" does save power, but decoding then fails on every suspend/resume cycle:
#
#   [ffmpeg/video] hevc: Failed to end picture decode issue: 23
#   [ffmpeg/video] hevc: hardware accelerator failed to decode picture
#
# The V4L2 driver keeps it powered for a reason; fix the driver's runtime PM
# before touching this device.
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="a600000.usb", ATTR{power/control}="auto"
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="a800000.usb", ATTR{power/control}="auto"
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="xhci-hcd.*.auto", ATTR{power/control}="auto"
